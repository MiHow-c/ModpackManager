<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <!-- GitHub owner/repo whose releases carry update.json; empty disables update checks -->
    <UpdateRepository>MiHow-c/ModpackManager</UpdateRepository>
  </PropertyGroup>
</Project>
