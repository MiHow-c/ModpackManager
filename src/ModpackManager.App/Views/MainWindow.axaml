<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModpackManager.App.ViewModels"
        xmlns:v="using:ModpackManager.App.Views"
        xmlns:pages="using:ModpackManager.App.Views.Pages"
        xmlns:res="using:ModpackManager.App.Resources"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="ModpackManager.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static res:Strings.AppTitle}"
        Background="{DynamicResource App.Background}"
        Width="1360" Height="820" MinWidth="1100" MinHeight="680">
    <Grid ColumnDefinitions="248,*">
        <!-- sidebar: app identity, open pack, navigation, connection state -->
        <Border Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="4,4,0,20">
                    <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource App.Accent}">
                        <ic:SymbolIcon Symbol="Cube" FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.AppTitle}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.AppTagline}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,16" IsVisible="{Binding HasPack}">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Text="{x:Static res:Strings.CurrentPack}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PackName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PackName}" />
                        <TextBlock Classes="caption" Text="{Binding PackDetails}" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <Image Width="16" Height="16" Source="{Binding PackLoader, Converter={x:Static v:Ui.LoaderIcon}}"
                                   IsVisible="{Binding PackLoader, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding PackLoaderText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Border Classes="badge" Background="{DynamicResource Badge.Success.Background}" IsVisible="{Binding IsHosting}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ic:SymbolIcon Symbol="Server" FontSize="14" Foreground="{DynamicResource Badge.Success.Foreground}" />
                            <TextBlock Text="{x:Static res:Strings.HostActiveChip}" Foreground="{DynamicResource Badge.Success.Foreground}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="badge" Background="{DynamicResource Badge.Success.Background}" IsVisible="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ic:SymbolIcon Symbol="PlugConnected" FontSize="14" Foreground="{DynamicResource Badge.Success.Foreground}" />
                            <TextBlock Text="{x:Static res:Strings.ConnectedChip}" Foreground="{DynamicResource Badge.Success.Foreground}" />
                        </StackPanel>
                    </Border>
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnOpenClick"
                            IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{x:Static res:Strings.OpenPack}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                            <TextBlock Text="{x:Static res:Strings.OpenPack}" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding HasPack}" AutomationProperties.Name="{x:Static res:Strings.Refresh}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowSync" FontSize="16" />
                            <TextBlock Text="{x:Static res:Strings.Refresh}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="caption" Text="{Binding AppVersion}" FontSize="11" HorizontalAlignment="Center" />

                </StackPanel>

                <ListBox x:Name="Nav" Classes="nav" SelectedIndex="0" IsEnabled="{Binding HasPack}"
                         AutomationProperties.Name="{x:Static res:Strings.Navigation}">
                    <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.TabMods}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="PuzzlePiece" FontSize="18" />
                            <TextBlock Text="{x:Static res:Strings.TabMods}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.TabStats}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="DataHistogram" FontSize="18" />
                            <TextBlock Text="{x:Static res:Strings.TabStats}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.TabFiles}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="DocumentText" FontSize="18" />
                            <TextBlock Text="{x:Static res:Strings.TabFiles}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.TabSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="Settings" FontSize="18" />
                            <TextBlock Text="{x:Static res:Strings.TabSettings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{x:Static res:Strings.TabCollab}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ic:SymbolIcon Symbol="PeopleTeam" FontSize="18" />
                            <TextBlock Text="{x:Static res:Strings.TabCollab}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Border}"
                    BorderThickness="0,1,0,0" Padding="24,8">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="96" MinWidth="0" Margin="0,0,12,0"
                                 VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" IsVisible="{Binding IsUpdateAvailable}" Background="{DynamicResource App.AccentSubtle}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1" Padding="24,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="20" Foreground="{DynamicResource App.Accent}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" Text="{Binding UpdateNotes}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding UpdateNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                        <Button Content="{x:Static res:Strings.UpdateLater}" Command="{Binding DismissUpdateCommand}" />
                        <Button Classes="accent" Command="{Binding InstallUpdateCommand}" AutomationProperties.Name="{x:Static res:Strings.UpdateInstall}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowDownload" FontSize="16" />
                                <TextBlock Text="{x:Static res:Strings.UpdateInstall}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Panel>
                <Carousel SelectedIndex="{Binding #Nav.SelectedIndex}" IsVisible="{Binding HasPack}" IsEnabled="{Binding !IsBusy}">
                    <pages:ModsPage />
                    <pages:StatsPage />
                    <pages:FilesPage />
                    <pages:SettingsPage />
                    <pages:CollabPage />
                </Carousel>

                <!-- empty state before any pack is open -->
                <StackPanel IsVisible="{Binding !HasPack}" MaxWidth="440" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="16" Background="{DynamicResource App.AccentSubtle}" HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="FolderOpen" FontSize="36" Foreground="{DynamicResource App.Accent}" />
                    </Border>
                    <TextBlock Classes="pageTitle" Text="{x:Static res:Strings.NoPackTitle}" HorizontalAlignment="Center" />
                    <TextBlock Classes="caption" Text="{x:Static res:Strings.NoPack}" FontSize="13" TextAlignment="Center" />
                    <Button Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnOpenClick" AutomationProperties.Name="{x:Static res:Strings.OpenPack}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" />
                            <TextBlock Text="{x:Static res:Strings.OpenPack}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Panel>
        </DockPanel>
    </Grid>
</Window>
